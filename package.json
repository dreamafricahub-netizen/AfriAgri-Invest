{
  "name": "afriagri-invest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",

    "//": "Les garde-fous (CHECK, triggers, vue) ne sont PAS dans schema.prisma : Prisma ne sait pas les declarer. Ils sont donc chaines a chaque commande qui touche la structure, pour qu'on ne puisse pas les oublier.",
    "db:guardrails": "tsx prisma/scripts/apply-guardrails.ts",
    "db:push": "prisma db push && npm run db:guardrails",
    "db:migrate": "prisma migrate deploy && npm run db:guardrails",
    "db:verify": "tsx prisma/scripts/check-guardrails.ts",
    "db:seed": "tsx prisma/scripts/seed-fixtures.ts --commit",
    "db:backfill": "tsx prisma/scripts/backfill-ledger.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@supabase/supabase-js": "^2.95.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.31.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
